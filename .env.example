# Settings for `docker compose` (see the Docker section of the README). Copy this file to .env.
# .env is git-ignored. This is NOT the file the backend reads when you run it by hand: that is
# backend/.env.

# Use letters and digits only: the password is placed inside the DATABASE_URL.
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-16
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Used by `docker compose exec backend python seed.py`. The password needs 8+ characters and must
# not start with "change-me".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# The shop is served at http://localhost:<WEB_PORT>.
WEB_PORT=8080

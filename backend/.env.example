# Copy to backend/.env and adjust. Never commit the real .env file.
# When the database moves to Docker, only the host and port in DATABASE_URL change.
DATABASE_URL=postgresql://ecommerce:ecommerce-dev-password@localhost:5432/ecommerce
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
# Used by seed.py to create the first admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
